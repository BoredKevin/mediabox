{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins/' + auth.uid).exists()"
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "!data.exists() ? auth != null : data.child('tv/uid').val() === auth.uid",
        "tv": {
          ".validate": "newData.hasChildren(['uid'])"
        },
        "queue": {
          "$itemId": {
            ".write": "data.exists() && !newData.exists() && data.child('addedBy').val() === auth.uid"
          }
        },
        "searchRequests": {
          "$reqId": {
            ".read": "root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid",
            ".write": "auth != null && (!data.exists() ? (newData.child('requestedBy').val() === auth.uid) : (root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid || (data.child('requestedBy').val() === auth.uid && !newData.exists())))",
            ".validate": "!newData.exists() || (newData.hasChildren(['requestedBy', 'query', 'createdAt']) && newData.child('requestedBy').val() === auth.uid && newData.child('query').isString() && newData.child('query').val().length <= 200 && newData.child('createdAt').isNumber())"
          }
        },
        "searchResults": {
          "$reqId": {
            ".read": "auth != null && ($reqId.beginsWith(auth.uid + '_') || root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid)",
            ".write": "root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid || (auth != null && $reqId.beginsWith(auth.uid + '_') && !newData.exists())"
          }
        },
        "searchRateLimits": {
          ".write": "root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid",
          "$memberUid": {
            ".read": "auth != null && ($memberUid === auth.uid || root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid)",
            ".write": "root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid"
          }
        },
        "members": {
          "$memberUid": {
            ".read": "auth != null",
            ".write": "$memberUid === auth.uid || root.child('rooms/' + $roomId + '/tv/uid').val() === auth.uid",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "nickname": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 25)"
            },
            "command": {
              ".validate": "newData.val() === null || (newData.hasChildren(['type', 'createdAt']) && (newData.child('type').val() === 'play' || newData.child('type').val() === 'pause' || newData.child('type').val() === 'addToQueue' || newData.child('type').val() === 'removeFromQueue' || newData.child('type').val() === 'adjustVolume' || newData.child('type').val() === 'forceSkip' || newData.child('type').val() === 'reorderQueue' || newData.child('type').val() === 'forceRemoveFromQueue' || newData.child('type').val() === 'kickMember' || newData.child('type').val() === 'toggleFullscreen' || newData.child('type').val() === 'clearQueue' || newData.child('type').val() === 'toggleRoomLock' || newData.child('type').val() === 'toggleAutoplay' || newData.child('type').val() === 'toggleCountdown' || newData.child('type').val() === 'searchYouTube' || newData.child('type').val() === 'manageApiKeys'))"
            }
          }
        }
      }
    }
  }
}