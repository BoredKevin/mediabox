{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui.bkev.in/ai-skill/schema/component-meta.schema.json",
  "title": "ComponentMeta",
  "type": "object",
  "required": [
    "name",
    "exports",
    "importPath",
    "description",
    "whenToUse",
    "whenNotToUse",
    "antiPatterns",
    "props",
    "aiHints",
    "examples"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "exports": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "importPath": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "whenToUse": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "whenNotToUse": {
      "type": "array",
      "items": { "type": "string" }
    },
    "antiPatterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "whenToUse"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "whenToUse": { "type": "string" },
          "exampleProps": { "type": "object" }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "defaultValue": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relatedComponents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cssVar", "role"],
        "properties": {
          "cssVar": { "type": "string" },
          "tailwindClass": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "aiHints": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "code"],
        "properties": {
          "label": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },
    "radixPrimitive": {
      "type": "string"
    },
    "docsUrl": {
      "type": "string"
    }
  }
}
